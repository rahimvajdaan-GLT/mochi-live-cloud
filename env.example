# Configure in Vercel Settings → Environment Variables (do not commit secrets)
UPSTASH_REDIS_REST_URL=https://your-redis-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token
MOCHI_ADMIN_KEY=generate_a_long_random_secret_32plus_chars
# Optional: browser allowed origin for API; * is fine for public GET because writes require X-Mochi-Key
PUBLIC_ORIGIN=https://your-mochi-domain.vercel.app

# Optional AI-generated pet dialogue (server-side only). Leave unset for zero AI API cost.
OPENAI_API_KEY=your_secret_api_key
OPENAI_MODEL=gpt-4o-mini
